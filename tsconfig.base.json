{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@packages/config": ["packages/config/src/index.ts"],
      "@packages/logger": ["packages/logger/src/index.ts"],
      "@packages/database": ["packages/database/src/index.ts"],
      "@packages/permissions": ["packages/permissions/src/index.ts"],
      "@packages/discord-core": ["packages/discord-core/src/index.ts"],
      "@packages/modules": ["packages/modules/src/index.ts"],
      "@packages/shared": ["packages/shared/src/index.ts"]
    }
  }
}

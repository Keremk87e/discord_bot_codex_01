# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_OWNER_IDS=1234567890,9876543210
DISCORD_TEST_GUILD_ID=

# Bot Identity / Branding
BOT_NAME=AegisBot
BOT_SHORT_NAME=Aegis
BOT_DESCRIPTION=Your shield for scalable Discord community operations.
BOT_VERSION=1.0.0
BOT_WEBSITE_URL=https://example.com
BOT_SUPPORT_SERVER_URL=https://discord.gg/example
BOT_INVITE_URL=https://discord.com/api/oauth2/authorize?client_id=APP_ID&permissions=8&scope=bot%20applications.commands
BOT_DOCS_URL=https://example.com/docs
BOT_TERMS_URL=https://example.com/terms
BOT_PRIVACY_URL=https://example.com/privacy

# Bot Personality / Tone
BOT_PERSONALITY=Calm, protective, and practical.
BOT_DEFAULT_TONE=Professional
BOT_ERROR_TONE=Clear and direct
BOT_SUCCESS_TONE=Friendly and concise
BOT_HELP_STYLE=Structured step-by-step

# Visual Branding
BOT_BRAND_COLOR=#5865F2
BOT_ERROR_COLOR=#ED4245
BOT_SUCCESS_COLOR=#57F287
BOT_WARNING_COLOR=#FEE75C
BOT_INFO_COLOR=#5DADE2
BOT_DEFAULT_EMBED_FOOTER=Powered by AegisBot Platform
BOT_DEFAULT_EMBED_ICON_URL=https://cdn.discordapp.com/embed/avatars/0.png
BOT_LOGO_URL=https://example.com/logo.png
BOT_BANNER_URL=https://example.com/banner.png

# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_ENV=local

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegisbot?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API / Dashboard
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-me-with-long-random-secret
OAUTH_CALLBACK_URL=http://localhost:3001/auth/discord/callback

# Feature Flags
ENABLE_MODERATION_MODULE=true
ENABLE_AUTOMOD_MODULE=false
ENABLE_LOGGING_MODULE=true
ENABLE_WELCOME_MODULE=true
ENABLE_TICKETS_MODULE=true
ENABLE_REACTION_ROLES_MODULE=false
ENABLE_ANALYTICS_MODULE=true
ENABLE_PREMIUM_MODULE=false

# Limits / Defaults
DEFAULT_COMMAND_COOLDOWN_SECONDS=5
MAX_WARNINGS_BEFORE_ACTION=3
DEFAULT_LOCALE=en-US
DEFAULT_TIMEZONE=UTC

# Workers / Queue
WORKER_CONCURRENCY=5
QUEUE_PREFIX=aegisbot
